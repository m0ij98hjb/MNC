rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Suppliers collection:
    // - Anyone (unauthenticated) can CREATE a new supplier registration
    // - Only authenticated admins can READ, UPDATE, DELETE
    match /suppliers/{supplierId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Contact-form messages (contacts collection):
    // - Anyone can CREATE (the public /contact page submits anonymously)
    // - Any authenticated admin can READ (needed for the /admin/dashboard
    //   unread-message badge, shown to every role)
    // - Company Manager, HR Manager, or super admin can reply/update/delete
    //   (matches the /admin/messages route — the only roles granted access
    //   to it in ROLE_ALLOWED_ROUTES)
    match /contacts/{contactId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if cmsIsSuperAdmin() || (request.auth != null && calcRole() in ['company_manager', 'hr_manager']);
    }

    // Job applications submitted via the public /careers form. Contains
    // applicant PII (name, phone, email, CV URL):
    // - Anyone can CREATE (candidates apply anonymously)
    // - READ/UPDATE/DELETE restricted to the roles that actually work with
    //   recruitment (matches /admin/jobs* route access) plus the super admin
    match /jobApplications/{appId} {
      allow create: if true;
      allow read, update, delete: if cmsIsSuperAdmin()
        || (request.auth != null && calcRole() in ['hr_manager', 'company_manager', 'project_manager']);
    }

    // ══════════════════════════════════════════════════════════════
    // Purchasing / Procurement module — fully independent of the rules
    // above. Its own role system (purchasingUsers) drives every check,
    // and the workflow's state machine is enforced here (not just in
    // the UI) so no role can skip a stage of the approval chain.
    // ══════════════════════════════════════════════════════════════

    function purchIsSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'mm5329844@gmail.com';
    }

    function purchRole() {
      return (request.auth != null && request.auth.token.email == 'engineer.tester@mnc.com')
        ? 'procurement_manager'
        : (request.auth != null && exists(/databases/$(database)/documents/purchasingUsers/$(request.auth.uid))
            ? get(/databases/$(database)/documents/purchasingUsers/$(request.auth.uid)).data.role
            : null);
    }

    function purchInRoles(rolesList) {
      return purchIsSuperAdmin() || (request.auth != null && purchRole() in rolesList);
    }

    // Role/account profiles
    match /purchasingUsers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || purchIsSuperAdmin());
      allow create, update, delete: if purchIsSuperAdmin();
    }

    // Auto-increment counters (requestNumber / poNumber) — used inside client transactions
    match /purchasingMeta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Central admin users registry — manages main-dashboard access permissions
    // Only super admin can create/update/delete; authenticated users can read their own doc
    match /adminUsers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || purchIsSuperAdmin());
      allow create, update, delete: if purchIsSuperAdmin();
    }

    match /purchaseRequests/{requestId} {
      // The site engineer now signs at submission time (a signature dialog on
      // the public form), so a new request is created already past stage 1 —
      // straight into pending_procurement_approval.
      allow create: if request.auth != null
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending_procurement_approval'
        && (purchRole() != null || purchIsSuperAdmin());

      allow read: if request.auth != null && (
        resource.data.requesterUid == request.auth.uid ||
        purchInRoles(['site_supervisor','site_engineer','procurement_manager'])
      );

      // Field-level allowlists for each non-super-admin update branch below —
      // the status-transition checks alone only constrain the `status` field;
      // without this, e.g. a procurement_manager mid-pipeline-update could
      // smuggle in an edit to unrelated fields (projectName, items, ...) in
      // the same write. purchIsSuperAdmin() / the requester's own resubmit
      // stay unrestricted (a resubmit is a legitimate full-form edit).
      function decisionKeys() {
        return ['status','updatedAt','decidedByUid','decidedByName','approvalDecisionAt','budgetExceeded','budgetExceptionAcknowledgedBy','rejectionReason','returnReason'];
      }

      allow update: if request.auth != null && (
        // Requester edits + resubmits after being returned for revision — also
        // re-signed by the site engineer at resubmit time, so it goes straight
        // back to pending_procurement_approval rather than stage 1.
        (resource.data.requesterUid == request.auth.uid
          && resource.data.status == 'returned_for_revision'
          && request.resource.data.status == 'pending_procurement_approval') ||

        // Requester confirms delivery — after procurement approves, the
        // request's own submitter (not procurement, not a warehouse role)
        // attaches a receipt photo and marks it received once materials
        // physically arrive on site.
        (resource.data.requesterUid == request.auth.uid
          && resource.data.status == 'approved'
          && request.resource.data.status == 'received'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status','updatedAt','deliveryProof','deliveryConfirmedAt','deliveryConfirmedByUid','deliveryConfirmedByName'])) ||

        // Stage 1 — Site Engineer (legacy path, kept for any request still
        // sitting in pending_site_engineer_approval from before this change)
        (purchRole() == 'site_engineer'
          && resource.data.status == 'pending_site_engineer_approval'
          && request.resource.data.status in ['pending_procurement_approval','rejected','returned_for_revision']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(decisionKeys().concat(['items','totalQuantity','totalEstimatedCost']))) ||

        // Stage 2 — Procurement Manager (final approval)
        (purchRole() == 'procurement_manager'
          && resource.data.status == 'pending_procurement_approval'
          && request.resource.data.status in ['approved','rejected','returned_for_revision']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(decisionKeys())) ||

        // Procurement execution pipeline (Procurement Manager owns it end-to-end)
        (purchRole() == 'procurement_manager'
          && resource.data.status in ['approved','rfq_requested','quotations_received','po_issued','delivered_pending_receipt']
          && request.resource.data.status in ['rfq_requested','quotations_received','po_issued','delivered_pending_receipt','received']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','purchaseOrderId'])) ||

        // Completion / archive
        (purchRole() == 'procurement_manager'
          && resource.data.status == 'received'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','completedAt'])) ||
        (purchRole() == 'procurement_manager'
          && resource.data.status == 'completed'
          && request.resource.data.status == 'archived'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])) ||

        // Procurement Manager admin edit — same unrestricted access as super
        // admin, matching the /admin/purchasing/requests/[id]/edit page being
        // open to both roles (procurement_manager owns this module day-to-day).
        purchRole() == 'procurement_manager' ||

        purchIsSuperAdmin()
      );

      allow delete: if purchRole() == 'procurement_manager' || purchIsSuperAdmin();

      // Per-stage approval records (decision, signature, approver) — append-only
      match /approvals/{stageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      // Full activity log — append-only, never editable or deletable
      match /history/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Procurement's own vendor directory — intentionally separate from `suppliers`
    // above (different schema/purpose) to avoid any interference with that module.
    match /purchasingSuppliers/{id} {
      allow read: if request.auth != null;
      allow create, update: if purchInRoles(['procurement_officer','procurement_manager']);
      allow delete: if purchIsSuperAdmin();
    }

    match /purchaseRFQs/{id} {
      allow read: if request.auth != null;
      allow create, update: if purchInRoles(['procurement_officer','procurement_manager']);
      allow delete: if purchIsSuperAdmin();

      match /quotations/{supplierId} {
        allow read: if request.auth != null;
        allow create, update: if purchInRoles(['procurement_officer','procurement_manager']);
        allow delete: if purchIsSuperAdmin();
      }
    }

    match /purchaseOrders/{id} {
      allow read: if request.auth != null;
      allow create, update: if purchInRoles(['procurement_officer','procurement_manager']);
      allow delete: if purchIsSuperAdmin();
    }

    match /warehouseReceipts/{id} {
      allow read: if request.auth != null;
      allow create, update: if purchInRoles(['store_keeper','procurement_manager']);
      allow delete: if purchIsSuperAdmin();
    }

    match /purchaseNotifications/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if purchIsSuperAdmin();
    }

    // Per-project approved budget registry (Phase 2 — Budget Control)
    match /projectBudgets/{id} {
      allow read: if request.auth != null;
      allow create, update: if purchInRoles(['procurement_manager']);
      allow delete: if purchIsSuperAdmin();
    }

    // Running warehouse stock levels (Phase 2 — Warehouse Availability)
    match /warehouseStock/{id} {
      allow read: if request.auth != null;
      allow create, update: if purchInRoles(['store_keeper','procurement_officer','procurement_manager']);
      allow delete: if purchIsSuperAdmin();
    }

    // Log of stock issued directly from warehouse instead of purchased — append-only
    match /warehouseIssues/{id} {
      allow read: if request.auth != null;
      allow create: if purchInRoles(['procurement_officer','procurement_manager']);
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // Phase 1 CMS — Projects module + Media Library (additive; does not
    // touch any rule above). Mirrors the super-admin-only write model
    // already used elsewhere in this file (e.g. purchIsSuperAdmin()),
    // kept as its own function to stay fully independent/removable.
    // ══════════════════════════════════════════════════════════════
    function cmsIsSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'mm5329844@gmail.com';
    }

    match /projects/{projectId} {
      allow read: if resource.data.draft == false && resource.data.archived == false;
      allow read: if cmsIsSuperAdmin();
      allow create, update, delete: if cmsIsSuperAdmin();
    }

    match /mediaLibrary/{assetId} {
      allow read, write: if cmsIsSuperAdmin();
    }

    // Job postings (siteContent/jobs doc, array field `listings`) — public
    // read so /careers can list published jobs; write is allowed for the
    // super admin (Dashboard → Content → Jobs) and for the HR Manager role
    // (Dashboard → Current Jobs, a dedicated page since HR doesn't have
    // access to Content Management). Role comes from adminUsers/{uid}.role,
    // same source as calcRole() used elsewhere in this file.
    // Note: this is a single document holding all listings, so the
    // isPublished filter is applied client-side, not via a Firestore query —
    // unpublished job text is technically fetchable, which is acceptable
    // since job ad copy isn't sensitive data.
    match /siteContent/jobs {
      allow read: if true;
      allow write: if cmsIsSuperAdmin() || (request.auth != null && calcRole() == 'hr_manager');
    }

    // Sections rendered on public site pages (Hero, About/director+CEO
    // photos, Contact, /app) need public read so anonymous visitors can
    // load them — write stays super-admin-only via the CMS page.
    match /siteContent/home {
      allow read: if true;
      allow write: if cmsIsSuperAdmin();
    }
    match /siteContent/about {
      allow read: if true;
      allow write: if cmsIsSuperAdmin();
    }
    match /siteContent/contact {
      allow read: if true;
      allow write: if cmsIsSuperAdmin();
    }
    match /siteContent/app {
      allow read: if true;
      allow write: if cmsIsSuperAdmin();
    }

    // Remaining siteContent/* sections (services/calculator/settings tabs
    // in Content Management, plus any future ones) — not rendered on a
    // public page, so read/write stays super-admin-only.
    // (siteContent/jobs and the public sections above already have their
    // own broader rules.)
    match /siteContent/{section} {
      allow read, write: if cmsIsSuperAdmin();
    }

    // Small standalone settings docs (e.g. settings/director — the avatar
    // photo shown in the admin dashboard chrome for every logged-in role).
    // Low-sensitivity; any authenticated admin can read/update.
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // ══════════════════════════════════════════════════════════════
    // Cost Calculator — internal tool reports log (additive). Access is
    // governed by the general `adminUsers/{uid}.role` field — the same
    // source useRoleAccess()/roleBasedAccess.js reads client-side — kept
    // to the same 6 roles allowed to use the calculator itself.
    // ══════════════════════════════════════════════════════════════
    function calcRole() {
      return request.auth != null && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        : null;
    }

    function calcToolAllowed() {
      return cmsIsSuperAdmin() || (request.auth != null && calcRole() in [
        'project_manager', 'company_manager', 'engineering_manager',
        'site_engineer', 'procurement_manager'
      ]);
    }

    match /costReports/{reportId} {
      allow read, create: if calcToolAllowed();
      allow update, delete: if cmsIsSuperAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
